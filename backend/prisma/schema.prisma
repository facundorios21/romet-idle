// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  username  String
  coins     Float      @default(500.0) // Give 500 starting coins
  lastClaim DateTime   @default(now())
  role      String     @default("USER") // USER, ADMIN
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  inventory UserCard[]
}

model Card {
  id          String     @id
  name        String
  description String
  imageUrl    String
  rarity      String     // COMMON, RARE, EPIC, LEGENDARY, MYTHIC
  power       Int
  element     String     // FIRE, WATER, EARTH, AIR, LIGHT, SHADOW
  set         String
  owners      UserCard[]
}

model UserCard {
  id        Int     @id @default(autoincrement())
  userId    Int
  cardId    String
  count     Int     @default(1)
  isSpecial Boolean @default(false) // holographic/shiny versions
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, isSpecial])
}

model Pack {
  id            String @id // e.g. "basic", "standard", "legendary"
  name          String
  cost          Float
  cardsCount    Int
  probCommon    Float
  probRare      Float
  probEpic      Float
  probLegendary Float
  probMythic    Float
}
